# Public base URL used to prepend to image paths in production.
# Leave commented out for local development (paths resolve to /public).
# Example using jsDelivr:
# NEXT_PUBLIC_CDN_BASE=https://cdn.jsdelivr.net/gh/ncchen99/Photofolio@main/public
# Example using GitHub Raw directly:
# NEXT_PUBLIC_CDN_BASE=https://raw.githubusercontent.com/ncchen99/Photofolio/refs/heads/main/public

# The production domain/URL of your site. This is required for generating absolute Open Graph and Twitter Card tags.
# NEXT_PUBLIC_SITE_URL=https://ncchen99.github.io/Photofolio
